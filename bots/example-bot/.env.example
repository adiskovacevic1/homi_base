# copy to .env (git-ignored) and fill in - or just run install.ps1 / install.sh, which writes this and the vault for you
BOT_MODEL=claude-opus-5
# Claude searches the web server-side (Anthropic's own search, with citations); 0 = off, then Claude uses the kit's web_search like the other brains
BRAIN_WEB_SEARCH=1
BOT_SYSTEM=You are a concise, friendly assistant living in a Discord server. Answer briefly.
# tools the bot writes for itself
TOOL_TIMEOUT=30
# Discord user IDs allowed to make the bot new tools; empty means everyone who can talk to it
TOOL_CREATORS=
# channels it answers in without being @mentioned, by name or ID; empty means mention it everywhere
OPEN_CHANNELS=
# its own channel: created when it joins a server, where it introduces itself and answers everything; empty = none
HOME_CHANNEL=bot
# its running log: one line per thing it does on its own (tools built, used, forge jobs, ideas, keys needed); empty = off
ACTIVITY_CHANNEL=activity
# direct messages: owners = only the people in TOOL_CREATORS (others are pointed to the server); anyone; off
DM_POLICY=owners
# Tools that need a login or API key declare the name in their spec and get it from the vault (see README "Secrets"),
# or from a variable here with the same name, e.g. SOMESERVICE_API_KEY=...
# shared secret for the internal /ask endpoint (voice bot) and the forge (dev box); compose network only
INTERNAL_TOKEN=
# opens the vault at data/secrets_manager/vault.enc, which holds the Discord token, the model key, ElevenLabs and every tool secret.
# Setup writes it; console.ps1 edits the vault. Any key may also be set here as a plain variable (the vault wins when both exist).
VAULT_PASSPHRASE=
# the forge on the dev box builds tools the model cannot write in one go (needs INTERNAL_TOKEN); FORGE_URL= turns it off
FORGE_URL=http://bot-dev:8791
FORGE_TIMEOUT=480
# the console on this PC (served by the dev box, http://127.0.0.1:8792/console); the bot links people here to add a key
CONSOLE_URL=http://127.0.0.1:8792/console
# daily review: the bot proposes 1-3 new tools in chat at this local time (container TZ; set TZ= in the root .env); empty = off
IDEAS_AT=09:00
# where to post it, by channel name or ID; empty = the busiest channel of the day
IDEAS_CHANNEL=
