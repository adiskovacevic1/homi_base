# copy to .env (git-ignored). Same Discord identity as example-bot is fine.
DISCORD_TOKEN=
ANTHROPIC_API_KEY=
BOT_MODEL=claude-opus-5
# comma-separated; empty = answer every utterance
WAKE_WORDS=hey bot
# voice channels (names or IDs) it joins by itself when someone arrives; empty = only on !join. It leaves when the channel
# empties (EMPTY_LEAVE_MS, default 15000) or when someone says bye / tells it to leave
AUTO_JOIN=general
# ElevenLabs for hearing and speaking; leave the key empty to stay fully local (faster-whisper + Piper)
ELEVENLABS_API_KEY=
# pick one with: docker compose exec voice-bot node index.js --voices   (default is the premade voice "Rachel")
ELEVEN_VOICE_ID=
# optional: ELEVEN_TTS_MODEL=eleven_flash_v2_5  ELEVEN_TTS_FORMAT=mp3_44100_128  ELEVEN_STT_MODEL=scribe_v1  ELEVEN_STT_LANG=en
#           ELEVEN_TTS=0 or ELEVEN_STT=0 keeps that side local
# optional overrides: WHISPER_MODEL=base.en  PIPER_VOICE=en_US-lessac-medium  MIN_UTTERANCE_MS=600  VOICE_SYSTEM=...
# answer through DockerBot (tools + shared memory); unset = the voice bot talks to Claude directly
BRAIN_URL=http://example-bot:8790/ask
INTERNAL_TOKEN=
